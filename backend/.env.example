# copy to .env  (git-ignored: never commit a key; share it with teammates over a direct message)
OPENFDA_API_KEY=            # free: https://open.fda.gov/apis/authentication/  (without it: 1,000 requests/day per IP)
GEMINI_API_KEY=             # optional: photo reading + nicer card. https://aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
SOCRATA_APP_TOKEN=          # optional: lifts throttling on data.cdc.gov
CACHE_TTL_DAYS=30
